{
  "name": "marketplaces-mcp-ru",
  "version": "0.5.3",
  "description": "MCP-серверы для кабинетов Wildberries, Ozon, Яндекс Маркета и Авито: 1022 метода Seller API, safety-гейт на запись, поиск по-русски. MCP servers for Wildberries, Ozon, Yandex Market and Avito seller accounts.",
  "mcpServers": {
    "wildberries": {
      "command": "python3",
      "args": ["${extensionPath}/serve.py", "wb"]
    },
    "ozon": {
      "command": "python3",
      "args": ["${extensionPath}/serve.py", "ozon"]
    },
    "ozon-perf": {
      "command": "python3",
      "args": ["${extensionPath}/serve.py", "ozon-perf"]
    },
    "yandex-market": {
      "command": "python3",
      "args": ["${extensionPath}/serve.py", "yandex"]
    },
    "avito": {
      "command": "python3",
      "args": ["${extensionPath}/serve.py", "avito"]
    }
  },
  "contextFileName": "GEMINI.md"
}
